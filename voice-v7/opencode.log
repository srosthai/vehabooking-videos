import json, math, re, subprocess
from pathlib import Path
root=Path('/home/dev/Native-project/Video-Remotions/Vehabooking')
raw=root/'voice-v7/raw-p01.mp3'
trimmed=root/'voice-v7/p01-trim.wav'
final=root/'public/voice/pp-sr/p01.mp3'
TRIM=("silenceremove=start_periods=1:start_threshold=-45dB:start_silence=0.05,"
      "areverse,silenceremove=start_periods=1:start_threshold=-45dB:start_silence=0.05,areverse")
def run(cmd):
    return subprocess.run(cmd,text=True,capture_output=True,check=True)
# lead silence
p=run(['ffmpeg','-hide_banner','-nostats','-i',str(raw),'-af','silencedetect=noise=-45dB:d=0.01','-f','null','-'])
events=[(m.group(1),float(m.group(2))) for m in re.finditer(r'silence_(start|end):\s*(-?[0-9.]+)',p.stderr)]
lead_end=events[1][1] if events and events[0][0]=='start' and events[0][1]<=0.02 and events[1][0]=='end' else 0.0
T=max(0.0,lead_end-0.05)
# trim
run(['ffmpeg','-y','-v','error','-i',str(raw),'-af',TRIM,'-ac','1','-c:a','pcm_s16le',str(trimmed)])
def loudness(path):
    q=run(['ffmpeg','-hide_banner','-nostats','-i',str(path),'-filter_complex','ebur128=peak=true','-f','null','-'])
    m=re.search(r'Integrated loudness:\s*I:\s*(-?\d+(?:\.\d+)?)\s*LUFS',q.stderr)
    pm=re.search(r'True peak:\s*Peak:\s*(-?\d+(?:\.\d+)?)\s*dBFS',q.stderr)
    return float(m.group(1)), float(pm.group(1))
I,peak=loudness(trimmed)
gain=max(-4.0,min(4.0,-17.0-I))
run(['ffmpeg','-y','-v','error','-i',str(trimmed),'-af',f'volume={gain:.2f}dB','-ac','1','-c:a','libmp3lame','-b:a','192k',str(final)])
dur=float(subprocess.check_output(['ffprobe','-v','error','-show_entries','format=duration','-of','csv=p=0',str(final)],text=True).strip())
I2,peak2=loudness(final)
raw_starts=[["បង! ",0.14],["ចុង",0.64],["សប្ដាហ៍",0.79],["នេះ ",1.17],["ញុម",1.27],["ចង់",1.65],["ទៅ",1.85],["លេង",1.95],["សៀមរាប",2.10],["ហើយ។",2.48]]
segs=[[t,round(max(0.0,s-T),2)] for t,s in raw_starts]
frames=math.ceil(dur*30)
tp=root/'src/videos/10-private-pp-sr/timing.json'
tim=json.loads(tp.read_text())
tim['p01']['audioFrames']=frames
tim['p01']['segs']=segs
tp.write_text(json.dumps(tim,ensure_ascii=False,indent=1)+'\n')
print(f'lead_end={lead_end:.6f} T={T:.6f} loud_before={I:.2f} gain={gain:+.2f}dB duration={dur:.6f} frames={frames} loud_after={I2:.2f} peak={peak2:.2f}dBFS')
print('segs=',segs)
print('caption=', ''.join(t for t,s in segs))
