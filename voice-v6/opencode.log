import json, subprocess, math
for name in ['pp','fe']:
    tim=json.load(open(f'src/videos/10-private-pp-sr/timing.json' if name=='pp' else 'src/videos/11-ferry-03/timing.json'))
    print(name, 'entries', len(tim), 'keys', list(tim))
    for k,v in tim.items():
        d=float(subprocess.check_output(['ffprobe','-v','error','-show_entries','format=duration','-of','csv=p=0',f'public/voice/pp-sr/{k}.mp3' if name=='pp' else f'public/voice/ferry-03/{k}.mp3']).decode().strip())
        frames=math.ceil(d*30)
        ok='OK' if frames==v['audioFrames'] else 'MISMATCH'
        print(f' {k}: {d:.3f}s {frames}f stored={v["audioFrames"]} {ok} segs={len(v["segs"])} first={v["segs"][0]} last={v["segs"][-1]}')
