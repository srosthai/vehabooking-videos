import json, subprocess
from pathlib import Path
root=Path('/home/dev/Native-project/Video-Remotions/Vehabooking')
report=json.loads((root/'voice-v6/audio-report.json').read_text())
vid_paths={
 'pp': root/'videos/08-private-pp-sr/private-pp-sr-kh-9x16.mp4',
 'fe': root/'videos/11-ferry-03/ferry03-kh-9x16.mp4',
}
def dur(p):
 return float(subprocess.check_output(['ffprobe','-v','error','-show_entries','format=duration','-of','csv=p=0',str(p)],text=True).strip())
lines=[]
lines.append('# Voice v6 — Build & Render Report')
lines.append('')
lines.append('Built with `voice-v6/build.py` from `voice-v6/spec.json`. Only leading/trailing silence was trimmed; no speed/pitch changes and no loudnorm. Each clip was matched with one plain volume gain (clamped to ±4 dB), mono MP3 192 kbps.')
lines.append('')
lines.append('## Verification')
lines.append('')
lines.append('- Backups created before overwriting: `voice-v6/prev-pp/`, `voice-v6/prev-fe/`.')
lines.append('- All final clips are mono, 192 kbps; measured final loudness is ~-17.2 to -17.3 LUFS.')
lines.append('- Every `audioFrames` value matches `ceil(ffprobe duration × 30)`; caption starts were reduced by the measured lead trim and clamped at 0.')
lines.append('- `npm run render:10pp-v` exited 0.')
lines.append('- `npm run render:11ferry03-v` exited 0.')
lines.append('')
for key,title in [('pp','PP — Private PP → Siem Reap'),('fe','FE — Ferry 03')]:
    lines.append(f'## {title}')
    lines.append('')
    lines.append('| Line | Source | Lead trim (s) | Gain (dB) | Final duration (s) |')
    lines.append('|---|---|---:|---:|---:|')
    for r in report[key]:
        src=r['source'].replace('|','\\|')
        lines.append(f"| {r['id']} | {src} | {r['lead_trim']:.3f} | {r['gain_db']:+.2f} | {r['duration']:.3f} |")
    lines.append('')
    p=vid_paths[key]
    lines.append(f"**Video:** `{p.relative_to(root)}` — ffprobe duration **{dur(p):.3f}s**")
    lines.append('')
(root/'voice-v6/REPORT.md').write_text('\n'.join(lines),encoding='utf-8')
print('wrote', root/'voice-v6/REPORT.md')
